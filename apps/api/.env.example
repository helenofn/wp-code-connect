# Secret used to sign JWTs. Required: the app won't start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Token lifetime in the `ms` format (60, "15m", "1h", "7d"). Defaults to 1h.
JWT_EXPIRES_IN=1h

# Postgres connection string. Matches the defaults in the root docker-compose.yml
# (start it with `pnpm db:up`). Required: the app won't start without it.
DATABASE_URL=postgres://codeconnect:codeconnect@localhost:5432/code_connect
